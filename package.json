{
  "name": "erudite-flashcards",
  "version": "0.1.0",
  "description": "A local-first Electron flashcard app extracted from the Productivity Toolkit.",
  "main": "main.js",
  "author": "Sambhav Jain <eruditespartan@gmail.com>",
  "private": true,
  "scripts": {
    "start": ".\\node_modules\\electron\\dist\\electron.exe .",
    "package": "electron-builder --win portable",
    "dist": "electron-builder --win",
    "build:mobile": "node scripts/build-mobile-web.js",
    "build:site": "node scripts/build-site.js",
    "zip:premade": "node scripts/zip-premade-decks.js",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "sortablejs": "^1.15.2",
    "sql.js": "^1.14.1",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.20.2"
  },
  "build": {
    "appId": "com.erudite.flashcards",
    "productName": "Erudite Flashcards",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!android/**",
      "!www/**",
      "!scripts/**",
      "!capacitor.config.json",
      "!node_modules/@capacitor/**",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icons/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Erudite-Flashcards-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
