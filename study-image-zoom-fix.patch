--- study.css
+++ study.fixed.css
@@ -1894,3 +1894,76 @@
     opacity: 1;
 }
 
+/* Final image-click isolation and mobile card sizing overrides */
+.flashcard {
+    cursor: default;
+}
+
+.flashcard .card-face {
+    cursor: pointer;
+}
+
+.image-container.has-image,
+.image-container.has-image *,
+.card-image-zoomable {
+    cursor: zoom-in !important;
+}
+
+.card-image-zoomable {
+    pointer-events: auto !important;
+    user-select: none;
+    -webkit-user-select: none;
+    -webkit-user-drag: none;
+    touch-action: manipulation;
+}
+
+@media (max-width: 720px) {
+    .study-area {
+        display: grid !important;
+        grid-template-columns: 3rem minmax(0, calc(100vw - 7.25rem)) 3rem !important;
+        gap: 0.6rem !important;
+        padding: 0 0.45rem !important;
+    }
+
+    .card-container {
+        width: min(760px, calc(100vw - 7.25rem)) !important;
+        max-width: none !important;
+    }
+
+    .flashcard {
+        height: min(440px, calc(100vh - 205px)) !important;
+        min-height: min(320px, calc(100vh - 205px));
+    }
+}
+
+@media (max-width: 520px) {
+    .study-area {
+        grid-template-columns: 1fr !important;
+        padding: 0 !important;
+    }
+
+    .nav-button {
+        display: none !important;
+    }
+
+    .card-container {
+        width: calc(100vw - 1.25rem) !important;
+        max-width: none !important;
+    }
+
+    .flashcard {
+        height: min(460px, calc(100vh - 185px)) !important;
+        min-height: min(330px, calc(100vh - 185px));
+    }
+
+    .card-face {
+        padding: 0.85rem !important;
+    }
+
+    .term-text,
+    .definition-text {
+        padding-left: 0.5rem !important;
+        padding-right: 0.5rem !important;
+    }
+}
+
